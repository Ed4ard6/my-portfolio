# Copia este archivo a .env y completa valores reales.
DB_HOST=localhost
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# URL pública base de la app (sin slash final)
APP_URL=http://localhost

# Transporte de correo: mail (función mail de PHP) o smtp (recomendado en hosting)
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@tudominio.com
# Tip hosting: en muchos proveedores MAIL_FROM debe coincidir con SMTP_USERNAME.
MAIL_FROM_NAME=My Portfolio

# Configuración SMTP (obligatoria si MAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=no-reply@tudominio.com
SMTP_PASSWORD=tu_password_smtp
SMTP_HELO_DOMAIN=
# Modo de autenticación SMTP: auto (recomendado), login o plain
SMTP_AUTH_MODE=auto

# Alias compatibles (si prefieres prefijo MAIL_ para SMTP)
# MAIL_HOST=smtp.tudominio.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=no-reply@tudominio.com
# MAIL_PASSWORD=tu_password_smtp
# MAIL_FROM_EMAIL=no-reply@tudominio.com
